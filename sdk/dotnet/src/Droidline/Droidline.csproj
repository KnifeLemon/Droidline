<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Droidline</RootNamespace>
    <AssemblyName>Droidline</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <PackageId>Droidline</PackageId>
    <Version>0.1.5</Version>
    <Authors>Droidline contributors</Authors>
    <Description>Android automation from C# and .NET: test your apps on real phones, script the tasks you repeat and run many phones at once. No ADB, no USB cable, no root.</Description>
    <PackageTags>android;android-automation;mobile-automation;ui-automation;test-automation;testing;appium;uiautomator;adb;accessibility;rpa;device-farm;mcp;dotnet;csharp;droidline</PackageTags>
    <PackageProjectUrl>https://droidline.dev</PackageProjectUrl>
    <RepositoryUrl>https://github.com/KnifeLemon/Droidline</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="Droidline.Tests" />
  </ItemGroup>

</Project>
