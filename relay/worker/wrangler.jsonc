{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "droidline-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "Relay" }]
  },
  // The Workers Free plan only offers SQLite-backed Durable Objects.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Relay"] }]
  // RELAY_TOKEN is a secret, not a var: npx wrangler secret put RELAY_TOKEN
}
